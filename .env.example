# Copy this file to .env and fill in your own keys. Never commit .env.

# Required: all LLM generation/chat completion calls go through OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-...

# Required: web search tool (company research, gap advice, legitimacy checks).
TAVILY_API_KEY=tvly-...

# Optional: override the default models used by each phase.
# EXTRACTION_MODEL=google/gemini-2.5-flash
# ANALYSIS_MODEL=anthropic/claude-sonnet-4.5
# AGENT_MODEL=anthropic/claude-sonnet-4.5

# Optional: path to your resume (.pdf or .docx). Keep this OUTSIDE the repo.
# Can also be passed as a CLI argument to `npm run gaps`.
RESUME_PATH=/absolute/path/to/your-resume.docx

# Optional: set to "debug" to enable verbose diagnostic logging on stderr.
# Equivalent to passing --debug on the command line.
LOG_LEVEL=info
